# ==============================================================
# FoodieBites Backend Environment Configuration Template
# ==============================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# For production on Render (Web Service), configure these exact
# variables under Environment tab in the Render Dashboard.
# ==============================================================

# Server Port (Render sets PORT automatically; defaults to 5000)
PORT=5000

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/food_ordering_db
# Production (MongoDB Atlas): Replace <username>, <password>, and <cluster-url>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/food_ordering_db?retryWrites=true&w=majority

# JWT Secret Key for token signing (use a long random secret in production)
JWT_SECRET=foodiebites_production_jwt_secret_key_wad_2026

# Deployed Frontend URL for CORS (Render Static Site URL)
# Example: https://foodiebites.onrender.com
CLIENT_URL=https://your-frontend-site.onrender.com
     