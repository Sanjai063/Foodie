# Dependencies
node_modules/
package-lock.json

# Environment Secrets (CRITICAL: Never commit to version control)
.env
.env.local
.env.production
.env.test
backend/.env
backend/.env.local
backend/.env.production

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Temporary and Scratch Directories
tmp/
temp/
scratch/
.system_generated/
